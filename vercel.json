{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "llm_firewall/proxy/app.py": {
      "maxDuration": 10,
      "excludeFiles": "{data/**,eval/**,training/**,tests/**,notebooks/**,docs/**,.github/**,models/transformer/**,models/transformer-smoke/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
