# Copy to .env and fill in. NEVER commit .env — it is git-ignored.

# --- Upstream LLM ---------------------------------------------------------
# "mock" (default) uses the built-in mock LLM: no network, no API key, no cost.
# For a real provider, use any OpenAI-compatible base URL, e.g.
#   https://api.groq.com/openai/v1   or   https://api.openai.com/v1
UPSTREAM_BASE_URL=mock
UPSTREAM_API_KEY=
UPSTREAM_MODEL=mock-llm-1
UPSTREAM_TIMEOUT_S=30

# --- Proxy protection -----------------------------------------------------
# Comma-separated client keys that may call /v1/chat/completions.
FIREWALL_API_KEYS=dev-key-change-me
# Requests per minute per client (token bucket refill rate) and burst size.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
# Hard limits on what a client may send.
MAX_REQUEST_BYTES=32768
MAX_PROMPT_CHARS=6000
# Total time budget for one proxied request (seconds).
REQUEST_TIMEOUT_S=45

# --- Detection / policy ---------------------------------------------------
POLICY_PATH=config/policy.yaml
LINEAR_MODEL_PATH=models/linear_model.json
# Directory produced by training/train_transformer.py (optional, local/Docker only).
TRANSFORMER_MODEL_DIR=models/transformer

# --- Audit logging --------------------------------------------------------
# Secret salt for HMAC-hashing prompts in logs. Change it in production.
LOG_HASH_SALT=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- Public demo ----------------------------------------------------------
# Enables the unauthenticated /api/scan + /api/demo endpoints used by the web page.
DEMO_MODE=true
